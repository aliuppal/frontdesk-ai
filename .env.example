# Copy to .env.local and fill in. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────────
# Neon → Connect → pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 32 random bytes, base64. Encrypts Google refresh tokens and signs OAuth state.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Public URL of this app. Optional on Vercel (falls back to the production domain).
# For local testing with real calls, use a tunnel (`ngrok http 3000`) URL here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Call recordings (Vercel Blob, private store) ─────────────────────────────
# Added automatically when you connect a Blob store to the Vercel project. For local dev: `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# ── Phone agent (Retell) ─────────────────────────────────────────────────────
# Also used to verify the x-retell-signature on webhooks and tool calls.
RETELL_API_KEY=
RETELL_LLM_MODEL=gpt-4.1-mini

# ── Google Calendar ──────────────────────────────────────────────────────────
# OAuth web client; redirect URI: <APP_URL>/api/google/callback. Enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="FrontDesk <bookings@yourdomain.com>"
