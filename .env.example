# Copy to .env.local and fill in. Never commit real values.

# Public URL of this app. Retell calls the tool + webhook endpoints here, so in local dev use a tunnel
# (e.g. `ngrok http 3000`) and put the https URL here, then click "Update agent now" in Settings.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retell → API Keys. Also used to verify the x-retell-signature on webhooks and tool calls.
RETELL_API_KEY=
# Conversation model inside Retell (billed per minute by Retell). Fast, cheap default:
RETELL_LLM_MODEL=gpt-4.1-mini

# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/google/callback. Enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend → API Keys. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="FrontDesk <bookings@yourdomain.com>"

# 32 random bytes, base64. Encrypts Google refresh tokens and signs OAuth state.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
