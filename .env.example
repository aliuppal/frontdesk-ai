# Copy to .env.local and fill in. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────────
# Neon → Connect → pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 32 random bytes, base64. Encrypts stored API keys (Cal.com) and derives voice tool keys.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Public URL of this app. Optional on Vercel (falls back to the production domain).
# For local testing with real calls, use a tunnel (`ngrok http 3000`) URL here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Call recordings (Vercel Blob, private store) ─────────────────────────────
# Added automatically when you connect a Blob store to the Vercel project. For local dev: `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# ── Voice agent (ElevenLabs Agents) ──────────────────────────────────────────
# API key needs: Agents (write), Tools (write), Phone numbers (write), Webhooks (write, for setup only).
ELEVENLABS_API_KEY=
# Printed by `npm run elevenlabs:setup -- <public app url>` (or copied from the webhook in the ElevenLabs
# dashboard). Verifies the ElevenLabs-Signature header on post-call webhooks.
ELEVENLABS_WEBHOOK_SECRET=
# Conversation model the agent runs on (billed by ElevenLabs).
ELEVENLABS_LLM=gpt-4.1-mini

# ── Phone numbers (Twilio) ───────────────────────────────────────────────────
# ElevenLabs answers calls on Twilio numbers. "Switch on my phone agent" buys a local number on this
# account and imports it into ElevenLabs. Use an API key SID/secret or the account SID/auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cal.com: no server key. Each business pastes its own Cal.com API key in Settings (stored encrypted).

# ── Email (Resend) ───────────────────────────────────────────────────────────
# EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="FrontDesk <bookings@yourdomain.com>"
